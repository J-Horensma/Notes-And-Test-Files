<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap"
>

  <Identity
    Name="JHorensma.AESGCMFileCrypter"
    Publisher="CN=JoelHorensma"
    Version="1.0.0.0" 
  />

  <Properties>
    <DisplayName>AES-GCM File-Crypter</DisplayName>
    <PublisherDisplayName>Joel Horensma</PublisherDisplayName>
    <Logo>Assets/StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19045.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
  <Application Id="AESGCMFileCrypter"
               Executable="AES-GCM File-Crypter.exe"
               EntryPoint="Windows.FullTrustApplication">

    <uap:VisualElements
        DisplayName="AES-GCM File-Crypter"
        Description="Encrypt or decrypt files and/or entire folders, quickly and securely, with AES-GCM (128, 192, and 256 bit) encryption."
        Square150x150Logo="Assets/Square150x150Logo.png"
        Square44x44Logo="Assets/Square44x44Logo.png"
        BackgroundColor="transparent">

        <uap:SplashScreen Image="Assets/SplashScreen.png" />

    </uap:VisualElements>

  </Application>
</Applications>

  <Capabilities>
    <rescap:Capability Name="broadFileSystemAccess" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

</Package>